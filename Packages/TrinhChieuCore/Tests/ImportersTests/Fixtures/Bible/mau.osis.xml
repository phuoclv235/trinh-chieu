  <osisText osisIDWork="thu" xml:lang="vi">
    <header>
      <work osisWork="thu">
        <title>Bản thử OSIS</title>
        <language>vi</language>
      </work>
    </header>
    <div type="book" osisID="Gen">
      <title type="main">Sáng-thế Ký (tệp)</title>
      <chapter osisID="Gen.1">
        <title type="section">Tiêu đề đoạn phải bị bỏ</title>
        <p>
          <verse osisID="Gen.1.1"><w lemma="strong:H7225">Ban đầu</w> là câu thử một.<note type="study">Chú thích phải bị bỏ.</note></verse>
          <verse osisID="Gen.1.2">Câu thử hai<note type="crossReference"><reference osisRef="John.1.1">Giăng 1:1</reference></note> có hai dòng.</verse>
        </p>
        <lg>
          <l><verse sID="Gen.1.3" osisID="Gen.1.3"/>Câu thử ba dòng thơ một,</l>
          <l>dòng thơ hai.<verse eID="Gen.1.3"/></l>
        </lg>
      </chapter>
    </div>
    <div type="book" osisID="John">
      <chapter sID="John.3" osisID="John.3"/>
      <verse sID="John.3.16" osisID="John.3.16"/>Câu thử Giăng ba mười sáu,<lb/>có ngắt dòng.<verse eID="John.3.16"/>
      <verse sID="John.3.17" osisID="John.3.17 John.3.18"/>Câu gộp mười bảy và mười tám.<verse eID="John.3.17"/>
      <verse sID="John.3.19" osisID="John.3.19"/>   <verse eID="John.3.19"/>
      <chapter eID="John.3"/>
    </div>
    <div type="book" osisID="Tob">
      <chapter osisID="Tob.1"><verse osisID="Tob.1.1">Sách ngoài quy điển.</verse></chapter>
    </div>
  </osisText>
